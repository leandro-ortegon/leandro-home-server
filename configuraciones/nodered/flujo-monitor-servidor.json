  {
    "id": "srv_fn",
    "type": "function",
    "z": "srv_tab",
    "name": "Repartir datos",
    "func": "// Reparte el JSON de estado-servidor.sh a cada widget y a MQTT\nconst e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\n\nconst servicio = ok => ok ? '🟢 Activo' : '🔴 Detenido';\nconst s = e.uptime || 0;\nconst d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);\nconst uptime = `${d} d ${h} h ${m} min · carga ${e.load}`;\nconst hdd = e.hdd_montado ? `🟢 Montado · ${e.hdd_libre_gb} GB libres` : '🔴 NO montado';\n\nnode.status({ fill: (e.temp > 75 || !e.hdd_montado) ? 'red' : 'green', shape: 'dot',\n              text: `CPU ${e.cpu}% · RAM ${e.ram}% · ${e.temp}°C` });\n\nreturn [\n  { payload: e.cpu },\n  { payload: e.ram },\n  { payload: e.temp },\n  { payload: e.sd_uso },\n  { payload: e.hdd_uso ?? 0 },\n  { payload: hdd },\n  { payload: servicio(e.mosquitto) },\n  { payload: servicio(e.nodered) },\n  { payload: servicio(e.samba) },\n  { payload: uptime },\n  { topic: 'domotica/servidor/estado', payload: e, retain: true }\n];\n",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 120,
    "wires": [
      [
        "g_cpu"
      ],
      [
        "g_ram"
      ],
      [
        "g_temp"
      ],
      [
        "g_sd"
      ],
      [
        "g_hdd"
      ],
      [
        "t_hdd"
      ],
      [
        "t_mq"
      ],
      [
        "t_nr"
      ],
      [
        "t_smb"
      ],
      [
        "t_up"
      ],
      [
        "mq_out"
      ]
    ]
  },
