# /etc/systemd/system/taildrop-recibir.service
[Unit]
Description=LEANDRO HOME SERVER - Recibir archivos de Taildrop en /srv/servidor/archivos/Taildrop
After=tailscaled.service
Requires=tailscaled.service
RequiresMountsFor=/srv/servidor

[Service]
User=leandro
ExecStartPre=/bin/mkdir -p /srv/servidor/archivos/Taildrop
ExecStart=/usr/bin/tailscale file get --loop --conflict=rename /srv/servidor/archivos/Taildrop/
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
